{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Backtest CLI output (v1)",
  "oneOf": [
    {
      "$ref": "#/$defs/report"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "sweep",
        "runs"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "sweep": {
          "enum": [
            "entry_hour",
            "entry_weekday",
            "hedge_frequency",
            "hedge_tolerance"
          ]
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/report"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "error"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "enum": [
                "INVALID_INPUT",
                "DATA_UNAVAILABLE",
                "BACKTEST_FAILED"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "config": {
      "title": "Effective backtest config",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "underlying": {
          "enum": [
            "BTC",
            "ETH"
          ]
        },
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "entryHourUtc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "hourlyOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "entryWeekday": {
          "type": "integer",
          "minimum": -1,
          "maximum": 6
        },
        "hedgeEnabled": {
          "type": "boolean"
        },
        "hedgeIntervalHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "hedgeMode": {
          "enum": [
            "time",
            "tolerance"
          ]
        },
        "hedgeDeltaTolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "exitMode": {
          "enum": [
            "after_days",
            "weekly_schedule",
            "expiry"
          ]
        },
        "holdToExpiry": {
          "type": "boolean"
        },
        "exitHoldDays": {
          "type": "integer",
          "minimum": 1
        },
        "exitWeekday": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "exitHourUtc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "longOption": {
          "type": "boolean"
        },
        "targetDteDays": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "farTargetDteDays": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minWeeklyDteDays": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxWeeklyDteDays": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "notionalUsd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sizingMode": {
          "enum": [
            "notional",
            "btc"
          ]
        },
        "btcQuantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "structure": {
          "enum": [
            "straddle",
            "strangle",
            "risk_reversal",
            "call",
            "put",
            "covered_call",
            "collar",
            "butterfly",
            "condor",
            "call_spread",
            "put_spread",
            "calendar_spread"
          ]
        },
        "targetDelta": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.5
        },
        "wingDelta": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 0.5
        },
        "includeGreekAttribution": {
          "type": "boolean"
        }
      },
      "required": [
        "underlying",
        "start",
        "end",
        "entryHourUtc",
        "hourlyOffset",
        "entryWeekday",
        "hedgeEnabled",
        "hedgeIntervalHours",
        "hedgeMode",
        "hedgeDeltaTolerance",
        "exitMode",
        "holdToExpiry",
        "exitHoldDays",
        "exitWeekday",
        "exitHourUtc",
        "longOption",
        "targetDteDays",
        "farTargetDteDays",
        "minWeeklyDteDays",
        "maxWeeklyDteDays",
        "notionalUsd",
        "sizingMode",
        "btcQuantity",
        "structure",
        "targetDelta",
        "wingDelta",
        "includeGreekAttribution"
